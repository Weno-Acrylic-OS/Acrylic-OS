#!/bin/sh

# acrylic-ui-start - Called by xinit to start the UI session

# Read the personality detected at boot
if [ -f /tmp/acrylic-personality ]; then
    PERSONALITY=$(cat /tmp/acrylic-personality)
else
    PERSONALITY="desktop" # Fallback
fi

# Run the window manager in the background.
/usr/bin/fluxbox &

# Wait a moment for the window manager to start
sleep 1

# Launch the browser, passing the personality as a URL parameter
/usr/bin/surf "file:///usr/share/acrylic-ui/index.html?personality=${PERSONALITY}"

